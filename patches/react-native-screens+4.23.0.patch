+                val fromUnhandled = statusBarInsets.top
+                if (fromUnhandled > 0) {
+                    fromUnhandled
+                } else {
+                    val decorView =
+                        (context as? ThemedReactContext)?.currentActivity?.window?.decorView
+                    if (decorView != null) getDecorViewTopInset(decorView) else 0
+                }
+            } else {
+                0
+            }
+
         val verticalInsets =
             InsetsCompat.of(
                 0,
-                max(cutoutInsets.top, if (shouldApplyTopInset) systemBarInsets.top else 0),
+                topInset,
                 0,
                 max(cutoutInsets.bottom, 0),
             )
